# ==========================================
# CodePilot — Authentication System Environment Variables
# ==========================================

# Environment Mode: development, testing, production
ENVIRONMENT=development
APP_NAME="CodePilot — The Knowledge of Athena"

# Service Base URLs
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/codepilot
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/codepilot

# Redis Configuration (Redis 7 with AOF persistence)
REDIS_URL=redis://localhost:6379/0

# GitHub OAuth Application Credentials
# Create at https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/integrations/github/callback
GITHUB_SCOPES=read:user,user:email

# Cryptographic Keys (Must be replaced with 32+ character random secrets in production)
SESSION_SECRET=change-this-in-production-session-secret-key-32-bytes-minimum
TOKEN_ENCRYPTION_KEY=change-this-in-production-token-encryption-key-32b

# Session & Cookie Security
SESSION_COOKIE_NAME=cp_session
CSRF_COOKIE_NAME=cp_csrf
SESSION_IDLE_TIMEOUT_SECONDS=43200     # 12 hours
SESSION_ABSOLUTE_LIFETIME_SECONDS=604800 # 7 days
COOKIE_SECURE=false                    # Set true in production (HTTPS)
COOKIE_SAMESITE=lax

# Optional AI / LLM Integration (Offline StaticAnalysisProvider used as fallback if unset)
GEMINI_API_KEY=
